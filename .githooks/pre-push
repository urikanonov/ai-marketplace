#!/bin/sh
# Pre-push hook: run the deterministic checks that gate `main` in CI, so a push
# that would fail a required check is caught locally before the CI round-trip.
#
# SCOPE (why this hook is deliberately fast). CI is the AUTHORITATIVE gate: `main` is
# protected and every required check runs there, sharded across runners. This hook is a
# convenience that catches the cheap, high-frequency mistakes (a stale generated artifact,
# a missing version bump or changelog entry, a schema slip) before a CI round-trip. It is
# NOT a second copy of CI. Measured on this repo, running the full local suites here cost
# ~30 minutes per push (script unit tests 640s, plugin Python suites up to 1082s), and the
# result was that 52% of observed pushes used `--no-verify` - a thorough hook that is
# bypassed half the time protects less than a fast one that always runs. So the suites are
# OPT-IN (PREPUSH_TESTS=1) and everything left here is seconds, not minutes.
#
# Enable once per clone:      git config core.hooksPath .githooks
# Skip for a single push:     git push --no-verify
# Also run the test suites:   PREPUSH_TESTS=1 git push
# Also run the browser E2E:   RUN_E2E=1 git push

export LC_ALL=C

PY=""
for _cand in python python3; do
  if command -v "$_cand" >/dev/null 2>&1 && "$_cand" -c "" >/dev/null 2>&1; then
    PY=$_cand
    break
  fi
done
if [ -z "$PY" ]; then
  echo "pre-push: a working python was not found; skipping local checks (CI will still run them)." >&2
  exit 0
fi

status=0
run() {
  _desc=$1
  shift
  echo "pre-push: $_desc"
  if ! "$@"; then
    echo "pre-push: FAILED - $_desc" >&2
    status=1
  fi
}

# Git exports its location variables to every hook, and they WIN over `git -C <dir>`. A test that
# spawns git in its own temp directory therefore operated on THIS repository instead: it staged
# fixtures into the real index, put a stray commit on the branch, and left the working tree dirty
# (issue #778, and the duplicate reports #772 / #773 - that is how `a.md` and `old.md` reached
# `main`). Run the test SUITES with those variables removed, so hermeticity does not depend on what
# each individual test remembers to do - including a test that shells out to a wrapper which spawns
# git in turn, which no per-test rule can see. The unset happens in a subshell, so the hook's own
# git calls below are unaffected. Keep this list in step with `_GIT_LOCATION_VARS` in
# scripts/_git_test_env.py (scripts/test_suite_hermeticity.py fails if they drift apart).
run_hermetic() {
  _desc=$1
  shift
  echo "pre-push: $_desc"
  if ! (
    unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY \
      GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_PREFIX \
      GIT_CEILING_DIRECTORIES GIT_NAMESPACE GIT_DISCOVERY_ACROSS_FILESYSTEM \
      GIT_INDEX_VERSION
    "$@"
  ); then
    echo "pre-push: FAILED - $_desc" >&2
    status=1
  fi
}

# Mirrors the required `validate` job: Markdown hygiene, manifest/plugin/skill
# validation, no-Backlog guard, script unit tests, and the changelog sync + history guard.
run "Markdown hygiene" "$PY" scripts/validate_markdown.py

if "$PY" -c "import yaml, jsonschema" >/dev/null 2>&1; then
  run "marketplace manifest, plugins, and skills" "$PY" scripts/validate_marketplace.py
else
  echo "pre-push: marketplace validator deps missing; 'pip install jsonschema pyyaml' to enable (skipping)." >&2
fi

# The scripts suite always runs through run_script_tests.py, never `unittest discover` directly:
# the runner launches it from a THROWAWAY working directory and fails if the suite left anything
# in it, or if this repository changed while it ran. That is what keeps a test's scratch fixture
# out of the repo root (issue #791 - `a.md` and `old.md` reached `main` that way).
# NOTE: measured at 639.8s serially (987.0s as the suite stands now), so this whole block -
# INCLUDING that sandbox/leak guard - is opt-in behind PREPUSH_TESTS. When it does run it fans out
# with --jobs auto (74.6s here across 16 workers), each worker in its own sandbox. Locally the
# guard therefore runs only when you ask for it; the required `validate` job always runs it, so a
# leak still cannot reach `main`.
# A long run while you keep editing would trip the repository diff on YOUR edits rather than on a
# leak; opt out of just that diff with PREPUSH_ALLOW_TREE_EDITS=1 instead of skipping every check
# with --no-verify.
_scripts_opts=""
if [ "${PREPUSH_ALLOW_TREE_EDITS:-0}" = "1" ]; then
  _scripts_opts="--no-worktree-check"
fi
if [ "${PREPUSH_TESTS:-0}" = "1" ]; then
  # shellcheck disable=SC2086 # deliberate word splitting: zero or one option
  run_hermetic "script unit tests" "$PY" scripts/run_script_tests.py --jobs auto $_scripts_opts
fi
run "spec test references" "$PY" scripts/check_spec_test_refs.py
run "doc-surface declarations for new features" "$PY" scripts/check_doc_surfaces.py
run "forbidden secret-bearing files" "$PY" scripts/check_forbidden_files.py
run "Backlog.md artifacts absent" "$PY" scripts/check_no_backlog.py

# Plugin Python suites. Opt-in (PREPUSH_TESTS=1) because a full local run measured ~1082s
# serially; when they do run they fan out across the CPUs with --jobs auto (~2.8x here), and
# only the suites of plugins changed versus origin/main run unless PREPUSH_FULL=1. CI shards
# and always runs the full set, so it remains the authoritative gate.
if [ "${PREPUSH_TESTS:-0}" = "1" ]; then
  if [ "${PREPUSH_FULL:-0}" = "1" ] || ! git rev-parse --verify --quiet origin/main >/dev/null 2>&1; then
    run_hermetic "plugin Python tests (all)" "$PY" scripts/run_plugin_python_tests.py \
      --require-discovered --jobs auto
  else
    run_hermetic "plugin Python tests (changed plugins vs origin/main; PREPUSH_FULL=1 for all)" \
      "$PY" scripts/run_plugin_python_tests.py --changed-only --base-ref origin/main --jobs auto
  fi
else
  echo "pre-push: test suites skipped (set PREPUSH_TESTS=1 to run them; CI runs them on every PR)."
fi

# These two need origin/main to diff against, so guard them on it being fetched
# (they mirror the required `validate` changelog step and the `version-bump` job).
if git rev-parse --verify --quiet origin/main >/dev/null 2>&1; then
  run "changelog sync and released-history guard" "$PY" scripts/check_changelog_sync.py
  run "version bump for changed plugins" "$PY" scripts/check_version_bump.py
else
  echo "pre-push: origin/main not found locally; 'git fetch origin' to enable the changelog-sync and version-bump checks (skipping)." >&2
fi

# Mirrors the required `site` (site drift) and `dist-in-sync` (layer dist) jobs.
run "site data in sync (build_site_data --check)" "$PY" scripts/build_site_data.py --check
run "commentable-html layer dist in sync (build.py --check)" "$PY" \
  plugins/commentable-html/dev/tools/build.py \
  --assets-dir plugins/commentable-html/dev/assets \
  --out-dir plugins/commentable-html/dev/skill \
  --pkg-dir plugins/commentable-html/pkg/skills/commentable-html \
  --examples-dir plugins/commentable-html/examples --check
run "commentable-html dev SPEC in sync (build_spec.py --check)" "$PY" \
  plugins/commentable-html/dev/tools/build_spec.py --check

if command -v node >/dev/null 2>&1; then
  run "commentable-html test fixtures in sync (generate.mjs --check)" \
    node plugins/commentable-html/dev/tests/fixtures/generate.mjs --check
else
  echo "pre-push: node not found; skipping the fixtures --check (CI will run it)." >&2
fi

# Browser E2E suites: opt-in. CI runs them on every PR as the required `site`
# (site) and `plugin-tests` (plugin) checks, so a push that regresses them is caught
# there; running them locally is available with RUN_E2E=1 for a full pre-push.
if [ "${RUN_E2E:-0}" = "1" ]; then
  if command -v node >/dev/null 2>&1; then
    # site/tests plus every plugin dev suite, discovered the way the plugin-tests CI
    # `discover` job does (plugins/*/dev/package.json), so a new plugin suite is picked
    # up automatically instead of silently skipped.
    suites="site/tests"
    for _pkg in plugins/*/dev/package.json; do
      [ -f "$_pkg" ] && suites="$suites ${_pkg%/package.json}"
    done
    for suite in $suites; do
      if [ -d "$suite/node_modules" ]; then
        echo "pre-push: Playwright suite ($suite)"
        ( cd "$suite" && npm test ) || { echo "pre-push: FAILED - Playwright ($suite)" >&2; status=1; }
      else
        echo "pre-push: RUN_E2E set but $suite/node_modules is missing; run 'npm ci' there first (skipping)." >&2
      fi
    done
  else
    echo "pre-push: RUN_E2E set but node not found; skipping the Playwright suites." >&2
  fi
else
  echo "pre-push: browser E2E skipped (set RUN_E2E=1 to run the Playwright suites; CI runs them on every PR)."
fi

if [ "$status" -ne 0 ]; then
  echo "pre-push: checks failed; push aborted. Fix the errors above, or use 'git push --no-verify' to skip." >&2
fi
exit "$status"
